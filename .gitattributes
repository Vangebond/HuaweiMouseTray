# 默认按文本处理，检出时用 CRLF（Windows 项目）
* text=auto eol=crlf

# PowerShell / VBS：必须 CRLF。
# 注意：带中文的 .ps1 必须保存为「UTF-8 with BOM」，否则 PowerShell 5.1 会按 GBK 解码成乱码。
# git 不会增删 BOM，所以提交前请确认编辑器没把 BOM 去掉。
*.ps1  text eol=crlf
*.vbs  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制
*.ico  binary
*.png  binary
*.exe  binary
